{
  "name": "teacher-workspace",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @teacher-workspace/host dev",
    "build": "pnpm --filter @teacher-workspace/host build",
    "preview": "pnpm --filter @teacher-workspace/host preview",
    "lint": "oxlint",
    "format": "oxfmt \"**/*.{js,jsx,ts,tsx,md,html,css,json,jsonc,yaml,yml,toml}\"",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  }
}
