# Teacher Workspace server configuration.
#
# Copy this file to .env at the repository root.
#
# Durations use Go syntax, for example 500ms, 30s, 15m, or 3h.

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------

# Runtime mode: "development" or "production".
TW_ENV=development

# Minimum log level: "debug", "info", "warn", or "error" (case-insensitive).
TW_LOG_LEVEL=info

# Development only: the host dev server (pnpm dev) that page requests are
# proxied to, so hot reload works through the Go server.
# TW_DEV_SERVER_URL=http://127.0.0.1:3001

# Production only: the built host app (pnpm build) served as static files. The
# directory must exist at startup.
# TW_BUILD_DIR=apps/host/dist

# ------------------------------------------------------------------------------
# HTTP Server
# ------------------------------------------------------------------------------

# Port the server listens on, 1-65535.
TW_SERVER_PORT=3000

# Timeouts for reading and writing each connection. 0 means no timeout.
# TW_SERVER_READ_HEADER_TIMEOUT=2s
# TW_SERVER_READ_TIMEOUT=15s
# TW_SERVER_WRITE_TIMEOUT=30s
# TW_SERVER_IDLE_TIMEOUT=60s

# ------------------------------------------------------------------------------
# Session
# ------------------------------------------------------------------------------

# Name of the session cookie. Must be a valid cookie name.
# TW_SESSION_NAME=tw_session

# How long a session lives before and after sign-in. Each must be at least 1s.
# TW_SESSION_DEFAULT_TTL=3h
# TW_SESSION_AUTHENTICATED_TTL=30m

# Whether the session cookie is restricted to HTTPS. Defaults to true; set it to
# false when serving over plain HTTP, as in local development.
TW_SESSION_SECURE=false

# Where sessions are stored: "memory" (lost on restart, not shared between
# processes) or "valkey".
# TW_SESSION_STORE_PROVIDER=memory

# Limits on the in-memory store, applied when TW_SESSION_STORE_PROVIDER=memory.
# Past either one it drops expired sessions first, then the least recently used.
# 67108864 bytes is 64 MiB.
# TW_SESSION_MEMORY_MAX_ENTRIES=50000
# TW_SESSION_MEMORY_MAX_BYTES=67108864

# Required when TW_SESSION_STORE_PROVIDER=valkey. The prefix is prepended to
# every session key.
# TW_SESSION_VALKEY_URL=valkey://default:secret@127.0.0.1:6379
# TW_SESSION_VALKEY_PREFIX=session:

# ------------------------------------------------------------------------------
# Edupass
# ------------------------------------------------------------------------------

# Edupass endpoints and the client registered for this app. The values below are
# local development placeholders.
TW_EDUPASS_ISSUER_URL=http://localhost:9000
TW_EDUPASS_AUTH_URL=http://localhost:9000/authorize
TW_EDUPASS_TOKEN_URL=http://localhost:9000/token
TW_EDUPASS_JWKS_URL=http://localhost:9000/jwks

TW_EDUPASS_CLIENT_ID=teacher-workspace
TW_EDUPASS_REDIRECT_URL=http://localhost:3000/auth/edupass/callback
TW_EDUPASS_CLIENT_AUTH_METHOD=client_secret_post
TW_EDUPASS_CLIENT_SECRET=teacher-workspace-secret
# TW_EDUPASS_CLIENT_SECRET_FILE=
# TW_EDUPASS_CLIENT_PRIVATE_KEY=
# TW_EDUPASS_CLIENT_PRIVATE_KEY_FILE=
# TW_EDUPASS_CLIENT_CERTIFICATE=
# TW_EDUPASS_CLIENT_CERTIFICATE_FILE=

# ------------------------------------------------------------------------------
# Remote Apps
# ------------------------------------------------------------------------------

# Lifetime of the signed token sent to each backend. Must be at least 1s.
# TW_REMOTE_SIGNED_TOKEN_TTL=1m

# Each remote app needs all of its values set, or none. Signing keys must be at
# least 32 bytes.
# TW_REMOTE_POSTS_MANIFEST_URL=https://posts.example.com/mf-manifest.json
# TW_REMOTE_POSTS_BACKEND_BASE_URL=https://api.posts.example.com
# TW_REMOTE_POSTS_BACKEND_SIGNING_KEY=a-string-secret-at-least-256-bits-long

# TW_REMOTE_STUDENT_INSIGHTS_MANIFEST_URL=https://student-insights.example.com/mf-manifest.json
# TW_REMOTE_STUDENT_INSIGHTS_BACKEND_BASE_URL=https://api.student-insights.example.com
# TW_REMOTE_STUDENT_INSIGHTS_BACKEND_SIGNING_KEY=a-string-secret-at-least-256-bits-long

# ------------------------------------------------------------------------------
# mock-edupass
# ------------------------------------------------------------------------------

MOCK_EDUPASS_URL=http://localhost:9000
MOCK_EDUPASS_PORT=9000

# Teacher Workspace Client Configuration
MOCK_EDUPASS_TW_ID=teacher-workspace
MOCK_EDUPASS_TW_REDIRECT_URI=http://localhost:3000/auth/edupass/callback
MOCK_EDUPASS_TW_AUTH_METHOD=client_secret_post
MOCK_EDUPASS_TW_SECRET=teacher-workspace-secret
# MOCK_EDUPASS_TW_SECRET_FILE=
# MOCK_EDUPASS_TW_CERTIFICATE=
# MOCK_EDUPASS_TW_CERTIFICATE_FILE=